# LocalCent Environment Configuration Template
# Copy this file to .env and fill in your values.

# Django Secret Key (Used for session signing, CSRF tokens, etc.)
# If left blank, a random one will be generated per-process instance (fine for local dev)
SECRET_KEY=

# Django Debug Mode (Set to False for production)
DEBUG=True

# Allowed Hosts (Comma separated list of hosts/domains)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Allowed Origins (Comma separated list of origins allowed to make API requests)
# E.g., the URL of your Vite development server or production frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173

# Encryption Key (REQUIRED)
# Used to encrypt sensitive data at rest (like API keys and PDF passwords)
# Must be a valid 32-url-safe base64-encoded string (e.g. Fernet key)
# Run `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` to generate one
ENCRYPTION_KEY=
